{
  "name": "pick-game",
  "version": "1.0.0",
  "description": "Pendulum Pick Game - Grab coins, avoid obstacles!",
  "main": "index.js",
  "scripts": {
    "start": "npx serve www -l 3000",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
